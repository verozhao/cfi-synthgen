+        # Always fp32, whatever `dtype` says: in bf16 ids above 256 collide (257 -> 256), which
+        # breaks 1024 px views (cols up to 447) and fractional glyph ids. Identical values <= 256.
         latent_image_ids = torch.zeros(height, width, 3)
