+    def prepare_glyph_tokens(
+        self,
+        batch_size,
+        dtype,
+        device,
+        glyph_instances=None,
+        glyph_latents=None,
+        glyph_ids=None,
+        glyph_sample_mode="argmax",
+        glyph_generator=None,
+    ):
+        """GlyphAnchor glyph tokens -> (latents [B, Ng, 4C] in dtype, ids [Ng, 3] fp32), or (None, None).
+
+        Either cfi-synthgen unitex.glyph_tokens GlyphInstances (VAE-encoded here with self.vae,
+        posterior mode by default so the shared pipeline generator is not consumed) or already
+        packed glyph_latents [1 | B, Ng, 4C] + glyph_ids [Ng, 3]. Ids live on the glyph plane
+        (axis 0 >= 1) with rows / cols on the target strip token grid.
+        """
+        if glyph_instances is not None:
+            if glyph_latents is not None or glyph_ids is not None:
+                raise ValueError("pass glyph_instances or glyph_latents + glyph_ids, not both")
+            from unitex import glyph_tokens  # cfi-synthgen on PYTHONPATH
+            glyph_latents, glyph_ids = glyph_tokens.encode_glyphs(
+                list(glyph_instances), self.vae, sample_mode=glyph_sample_mode,
+                generator=glyph_generator, device=device, dtype=dtype)
+        if glyph_latents is None and glyph_ids is None:
+            return None, None
+        if glyph_latents is None or glyph_ids is None:
+            raise ValueError("glyph_latents and glyph_ids go together")
+        glyph_ids = torch.as_tensor(glyph_ids).to(device=device, dtype=torch.float32)
+        glyph_latents = torch.as_tensor(glyph_latents).to(device=device, dtype=dtype)
+        if glyph_latents.ndim == 2:
+            glyph_latents = glyph_latents.unsqueeze(0)
+        if glyph_ids.ndim != 2 or glyph_ids.shape[1] != 3 or glyph_latents.shape[1] != glyph_ids.shape[0]:
+            raise ValueError(f"glyph_latents {tuple(glyph_latents.shape)} and glyph_ids {tuple(glyph_ids.shape)} do not match")
+        if glyph_latents.shape[-1] != 4 * self.vae.config.latent_channels:
+            raise ValueError(f"glyph_latents have {glyph_latents.shape[-1]} channels, packed latents have {4 * self.vae.config.latent_channels}")
+        if not torch.isfinite(glyph_ids).all() or (glyph_ids[:, 0] < 1).any():
+            # axis 0 = 0 is the target / condition plane: glyph tokens would take their positions
+            raise ValueError("glyph_ids must be finite with axis 0 >= 1 (the glyph plane)")
+        if glyph_latents.shape[0] == 1 and batch_size > 1:
+            glyph_latents = glyph_latents.repeat(batch_size, 1, 1)
+        return glyph_latents, glyph_ids
